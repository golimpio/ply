<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The keys build settings cannot set; the rest is generated (project.yml, INFOPLIST_KEY_*). -->
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ply finds and plays from the ply server on your home network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ply._tcp</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The launch screen is the app's own velvet, not the system's blank page (INFOPLIST_KEY_UILaunchScreen_Generation
	     is off in project.yml). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- ply makes no use of encryption beyond HTTPS; App Store Connect asks once per build without it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
