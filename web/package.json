{
  "name": "ply-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json && node scripts/check-tokens.mjs",
    "check:ts6": "svelte-check --tsconfig ./tsconfig.json",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run && node --test e2e/mock-items.test.mjs",
    "test:mock": "node --test e2e/mock-items.test.mjs",
    "e2e": "node e2e/player-wiring.mjs && node e2e/player-limits.mjs && node e2e/metadata-ui.mjs && node e2e/activity-ui.mjs && node e2e/folders-ui.mjs && node e2e/player-controls.mjs && node e2e/tvdb-ui.mjs && node e2e/ratings-ui.mjs && node e2e/navigation.mjs && node e2e/settings-ui.mjs && node e2e/library-ui.mjs && node e2e/player-ui.mjs && node e2e/watched-ui.mjs && node e2e/trailers-ui.mjs",
    "e2e:meta": "node e2e/metadata-ui.mjs",
    "e2e:tvdb": "node e2e/tvdb-ui.mjs",
    "e2e:ratings": "node e2e/ratings-ui.mjs",
    "e2e:activity": "node e2e/activity-ui.mjs",
    "e2e:trailers": "node e2e/trailers-ui.mjs",
    "e2e:visual": "node e2e/visual.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^5.1.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "playwright-core": "^1.65.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
